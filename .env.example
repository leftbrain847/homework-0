# Copy to .env and fill in. Never commit .env.
# Only required for Android production builds (EAS). Expo Go and iOS work without it.
GOOGLE_MAPS_ANDROID_API_KEY=

# Web preview live lookup (test feature). Session to message and the artifact's URL.
# See docs/LIVE_LOOKUP.md. Not secrets, but specific to one Claude session.
EXPO_PUBLIC_LOOKUP_SESSION_ID=
EXPO_PUBLIC_ARTIFACT_URL=
