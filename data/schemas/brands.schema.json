{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownership-map.example/schemas/brands.schema.json",
  "title": "Brands",
  "description": "Ownership is a brand-level fact. Cross-field rules (PE claims need a source, references must resolve) are enforced by scripts/validate-data.ts.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "cuisine",
      "parent_company",
      "ownership_chain",
      "status",
      "stake_type",
      "confidence",
      "acquired_year",
      "exited_year",
      "source_url",
      "last_verified",
      "independent_group"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "name": { "type": "string", "minLength": 1 },
      "cuisine": { "$ref": "cuisine.schema.json" },
      "parent_company": {
        "description": "Firm id of the brand's direct parent, or null.",
        "type": ["string", "null"]
      },
      "ownership_chain": {
        "description": "Ordered from the ultimate owner down to the brand's direct parent. Each level lists one or more firm ids (more than one = co-owners).",
        "type": "array",
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "status": { "enum": ["current", "exited", null] },
      "stake_type": { "enum": ["majority", "minority", null] },
      "confidence": { "enum": ["confirmed", "reported", null] },
      "acquired_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
      "exited_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
      "source_url": { "type": ["string", "null"], "format": "uri" },
      "last_verified": { "type": ["string", "null"], "format": "date" },
      "independent_group": {
        "description": "True for a small locally owned group with several restaurants. Counts as Independent. Must not have a PE firm in its chain.",
        "type": "boolean"
      }
    }
  }
}
